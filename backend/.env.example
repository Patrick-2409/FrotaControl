# Copie para .env e preencha. Nunca commite .env com segredos reais.

PORT=4000
NODE_ENV=development

# Obrigatório em todos os ambientes
DATABASE_URL=postgres://postgres:postgres@localhost:5432/frotacontrol
JWT_SECRET=troque-esta-chave-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=30d

# Seed automático de SUPER_ADMIN: permitido só em development/test
# ou via ENABLE_SUPERADMIN_SEED=true fora desses ambientes.
# Em produção, ENABLE_SUPERADMIN_SEED=true é bloqueado com erro explícito.
ENABLE_SUPERADMIN_SEED=false
SUPERADMIN_INITIAL_PASSWORD=
SUPERADMIN_INITIAL_EMAIL=admin@frotacontrol.com
SUPERADMIN_INITIAL_NAME=Super Admin

# URL pública do backend (PDFs/logos absolutos). No Render: https://seu-servico.onrender.com
# Se vazio, o servidor deduz de X-Forwarded-* nos requests.
PUBLIC_BASE_URL=
BACKEND_PUBLIC_URL=

# CORS: padrão em produção é permissivo (origin: true) para facilitar deploy.
# Para restringir origens, defina CORS_STRICT=true e liste em CORS_ORIGINS.
CORS_STRICT=false
CORS_ORIGINS=

# PostgreSQL: em produção o SSL é ligado por padrão. Local sem SSL: DATABASE_SSL=false
DATABASE_SSL=

MONITORING_DSN=
AUTH_DIAGNOSTIC_STRICT=false
USER_NAME_DIAGNOSTIC_STRICT=false

# IA operacional (somente backend)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=40000
INTELLIGENCE_AI_TIMEOUT_MS=20000
INTELLIGENCE_AI_DAILY_LIMIT=5
OP_AI_MONTHLY_LIMIT=10
OP_AI_COOLDOWN_SECONDS=60

# Upload persistente em produção (Render): Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Automações — webhook Telegram (Bloco 3: captura; NÃO ativado externamente)
# Valor do header X-Telegram-Bot-Api-Secret-Token esperado. Gere um valor
# longo e aleatório; nunca commitar o valor real. Sem isto definido, o
# webhook rejeita todas as requisições (fail-safe).
TELEGRAM_WEBHOOK_SECRET=

# Bot token usado pelo Bloco 4 para baixar fotos via getFile/download —
# NÃO ativado neste bloco (nenhuma automação real dispara este código ainda).
# Nunca preencher com um token real neste arquivo.
TELEGRAM_BOT_TOKEN=

# Automações — armazenamento no Google Drive (Bloco 4: download de fotos do
# Telegram + upload idempotente; NÃO ativado externamente). Nenhuma destas
# variáveis é lida por nenhum caminho de código chamado automaticamente hoje.
#
# GOOGLE_DRIVE_AUTH_MODE escolhe o modo de autenticação: SERVICE_ACCOUNT ou
# OAUTH_USER. Preencha SOMENTE o bloco de variáveis do modo escolhido.
GOOGLE_DRIVE_AUTH_MODE=

# Modo SERVICE_ACCOUNT (conta de serviço do Google Cloud com acesso à pasta
# raiz configurada em cada automacao_configs, ou a um Shared Drive).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Modo OAUTH_USER (conta pessoal do Google Drive do próprio cliente).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Opcional: ID de um Shared Drive (Drive compartilhado), quando a pasta raiz
# de alguma config vive lá em vez de "Meu Drive". Vazio = não usa Shared Drive.
GOOGLE_DRIVE_SHARED_DRIVE_ID=

# Limites/timeouts do Bloco 4 — todos têm um default seguro no código
# (automationStorageConfig.js) caso fiquem vazios; só defina para sobrescrever.
TELEGRAM_MEDIA_MAX_BYTES=
TELEGRAM_API_TIMEOUT_MS=
GOOGLE_DRIVE_TIMEOUT_MS=
AUTOMATION_STORAGE_MAX_ATTEMPTS=
